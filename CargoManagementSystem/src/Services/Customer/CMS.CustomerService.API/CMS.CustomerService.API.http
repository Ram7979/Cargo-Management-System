@CMS.CustomerService.API_HostAddress = http://localhost:5003
@AuthToken = your_jwt_token_here

### ========================================
### CREATING MULTIPLE CUSTOMERS (NO PREDEFINED DATA)
### Each POST creates a new unique customer - Unlimited!
### ========================================

### Customer 1: Individual - John Smith
POST {{CMS.CustomerService.API_HostAddress}}/api/v1/customers
Content-Type: application/json

{
  "fullName": "John Smith",
  "companyName": "Smith Trading Company",
  "contactPerson": "John Smith",
  "email": "john.smith@example.com",
  "phone": "+1-212-555-0100",
  "address": "123 Main Street",
  "city": "New York",
  "state": "NY",
  "zipCode": "10001",
  "country": "USA",
  "taxId": "12-3456789",
  "type": "Individual",
  "creditLimit": 50000,
  "paymentTerms": "Net 30"
}

###

