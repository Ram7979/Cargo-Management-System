@CMS.IdentityService.API_HostAddress = http://localhost:5001

### Login (Create JWT token)
POST {{CMS.IdentityService.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@cms.com",
  "password": "Admin@123"
}

### Refresh Token
POST {{CMS.IdentityService.API_HostAddress}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "your_refresh_token_here"
}

### Logout
POST {{CMS.IdentityService.API_HostAddress}}/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {your_jwt_token_here}

{
  "refreshToken": "your_refresh_token_here"
}

### Register New User (Requires SuperAdmin or OpsManager role)
POST {{CMS.IdentityService.API_HostAddress}}/api/v1/users
Content-Type: application/json
Authorization: Bearer {your_jwt_token_here}

{
  "email": "newuser@cms.com",
  "password": "NewPass@123",
  "firstName": "John",
  "lastName": "Doe"
}
